# Old address td-media.eu/rackwerk → permanent redirect (301) to rack.stagecraft.solutions.
# Path, query string and #hash (e.g. #pruefen=<key>) are kept.
# Upload: scripts/deploy.sh --dir redirect/td-media-rackwerk
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*)$ https://rack.stagecraft.solutions/$1 [R=301,L,NE]
</IfModule>
<IfModule !mod_rewrite.c>
  RedirectMatch 301 ^/rackwerk/?(.*)$ https://rack.stagecraft.solutions/$1
</IfModule>
<IfModule mod_headers.c>
  Header always set Cache-Control "max-age=86400"
</IfModule>
