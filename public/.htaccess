# Rack Manufaktur – Einstellungen für Apache-Webserver (auf anderen Servern wirkungslos)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Nur eigene Dateien laden; nichts von Dritten
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"

  # HTML immer neu prüfen, damit Updates sofort ankommen
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|js|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddCharset utf-8 .html .css .js .md .txt
</IfModule>

# Verzeichnisliste abschalten – einige Hoster erlauben das nicht (Fehler 500), dann auskommentiert lassen
# Options -Indexes

# HTTPS erzwingen – erst einschalten, wenn das SSL-Zertifikat aktiv ist.
# Viele Hoster bieten dafür auch einen Schalter im Kundenmenü.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
